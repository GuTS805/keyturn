{
  "name": "keyturn",
  "version": "0.1.0",
  "private": true,
  "description": "Two-person rule for software releases, enforced on NEAR",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test:mock": "node --test mock/registry.test.mjs",
    "test:contract": "cargo test --manifest-path contract/Cargo.toml",
    "test:worker": "cargo test --manifest-path worker/Cargo.toml",
    "build:worker": "cargo build --manifest-path worker/Cargo.toml",
    "build:worker:wasm": "cargo build --release --target wasm32-wasip2 --no-default-features --manifest-path worker/Cargo.toml",
    "mock": "node mock/registry.mjs",
    "install:cli": "npm --prefix cli install",
    "test:cli": "npm --prefix cli test",
    "test": "npm run test:contract && npm run test:worker && npm run build:worker && npm run test:mock && npm run test:cli",
    "build:contract": "cargo build --release --target wasm32-unknown-unknown --manifest-path contract/Cargo.toml",
    "setup:testnet": "node --env-file=.env cli/scripts/setup-testnet.mjs",
    "demo": "node --env-file=.env cli/scripts/demo.mjs",
    "demo:local": "node cli/scripts/demo.mjs --local",
    "demo:chrome": "node cli/scripts/demo-chrome.mjs",
    "npm:live": "node --env-file=.env cli/scripts/npm-live.mjs"
  }
}

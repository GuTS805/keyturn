# Copy to .env and fill in. .env is ignored by git. Never commit real values.

# NEAR
KEYTURN_NETWORK=testnet
# Main testnet account created with near CLI (the name only; the key stays in ~/.near-credentials)
KEYTURN_MAIN_ACCOUNT=
# Contract account (a sub-account of the main account is fine)
KEYTURN_CONTRACT=
# Account that signs CLI calls, and optionally its key (ed25519:...). If KEYTURN_KEY is empty,
# the near-cli credentials file for KEYTURN_ACCOUNT is used.
KEYTURN_ACCOUNT=
KEYTURN_KEY=
# Optional RPC override
KEYTURN_RPC=

# npm bot account (throwaway), used by the worker
# Granular token with "Read and write (publish and stage)" and bypass 2FA, scoped to the demo package.
# npm will remove direct publishing with bypass-2FA tokens in January 2027.
NPM_TOKEN=
# Only for the staged-approve mode, which needs an account that still has an authenticator app.
# New npm accounts cannot set one up, so leave these empty.
NPM_CI_TOKEN=
NPM_TOTP_SECRET=
KEYTURN_NPM_REGISTRY=https://registry.npmjs.org
# A package the token can publish, for the demo, e.g. @your-scope/keyturn-demo
KEYTURN_DEMO_PACKAGE=

# NEAR AI Cloud (only if the AI reviewer is built)
NEAR_AI_API_KEY=
